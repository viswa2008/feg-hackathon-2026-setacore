# PSK Compass — environment template
# Copy to .env and fill in. NEVER commit the real .env.

# App
NODE_ENV=development
PORT=8000

# Session Value Score weights (override config/scenario.json defaults)
SVS_WEIGHT_RELEVANCE=0.4
SVS_WEIGHT_INFORMEDNESS=0.3
SVS_WEIGHT_FRICTION=0.3

# Data source for the demo (sample|dataset)
DATA_SOURCE=sample

# Feature flags
ENABLE_SMART_START=true
ENABLE_CONFIDENCE_RAIL=true

# (Production placeholders — not used by the prototype)
# API_BASE_URL=
# ANALYTICS_KEY=
